{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/backup-schema.json",
  "title": "Boardy Connection backup",
  "type": "object",
  "required": ["version", "connections"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "const": 1,
      "description": "Backup format version. Must be 1."
    },
    "exportedAt": {
      "type": "string",
      "description": "ISO-8601 timestamp of when this file was written."
    },
    "connections": {
      "type": "array",
      "description": "People saved in this browser.",
      "items": {
        "type": "object",
        "required": ["id", "personName"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable unique id. The same id updates the same person."
          },
          "personName": { "type": "string", "minLength": 1 },
          "personRef": { "type": "string" },
          "linkedInUrl": { "type": "string" },
          "introContext": { "type": "string" },
          "status": {
            "enum": [
              "not_started",
              "ongoing",
              "scheduled",
              "met",
              "connected",
              "did_not_connect",
              "reschedule"
            ]
          },
          "meetingDateTime": { "type": "string" },
          "meetingUrl": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "userNotes": { "type": "string" },
          "rating": { "type": "number", "minimum": 1, "maximum": 5 },
          "needsUpdate": { "type": "boolean" },
          "statusHistory": { "type": "array" }
        }
      }
    }
  }
}
